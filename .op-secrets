# 1Password -> Cloudflare secret manifest.
# Format:  <1Password item>  <Cloudflare secret name>.  One column = same name both sides.
# Synced by automation/secret-sync/sync-secrets.sh on every `npm run deploy` (predeploy hook).
# Only these are managed; anything else on the Worker is left untouched and never deleted.

ANTHROPIC_API_KEY               ANTHROPIC_API_KEY
ATTIO_TOKEN                     ATTIO_TOKEN
# MOVED 2026-08-25 to Cloudflare Secrets Store — bound in wrangler.jsonc, do not re-push
# RECLAIM_WEBHOOK_SECRET          RECLAIM_WEBHOOK_SECRET
RESEND_API_KEY_ELC              RESEND_API_KEY
SLACK_BOT_TOKEN_ELC             SLACK_BOT_TOKEN_ELC
# "ELC Partner Chat" widget, sitekey 0x4AAAAAAEKh8uEYFTt9Kew0. This is a DIFFERENT widget from
# PARTNER_TURNSTILE_SECRET, which is "ELC Partner Offer" (0x4AAAAAAEHZgWTpssFQCedG) on elc-web.
# MOVED 2026-08-25 to Cloudflare Secrets Store — bound in wrangler.jsonc, do not re-push
# PARTNER_CHAT_TURNSTILE_SECRET   CHAT_TURNSTILE_SECRET
# unmanaged (Cloudflare-only, no backup): CHAT_SESSION_SECRET, SLACK_PARTNERS_CHANNEL
SLACK_WEBHOOK_URL       SLACK_WEBHOOK_URL
